# Copy to .env.local (or run `node scripts/write-local-env.mjs` against the local Supabase stack).
# Every value below is a FAKE placeholder. Never commit real keys.

# Supabase API origin. Public (shipped to the browser, used for the CSP connect-src allow-list).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# Publishable (anon-level) key. Public by design; protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_FAKE_FAKE_FAKE_FAKE

# SERVER ONLY. Secret key (service role). Read only by src/server/privileged.ts and scripts/bootstrap-admin.mjs.
# Must never be given a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_FAKE_FAKE_FAKE_FAKE

# Public origin of this app, no trailing slash. Used for email links and the auth redirect URL.
SITE_URL=http://127.0.0.1:3000

# Invitation email transport. In production SMTP_URL MUST be set (the mailer refuses to run without it).
# Local default (Mailpit): smtp://127.0.0.1:54425
SMTP_URL=smtp://127.0.0.1:54425
MAIL_FROM="MITRA <no-reply@mitra.example>"

# Local development only: Mailpit web/API (used by tests and scripts to read captured email).
MAILPIT_URL=http://127.0.0.1:54424

# --- Phase 2: verification documents ---
# ClamAV (clamd) for scanning uploads BEFORE they are stored. If CLAMD_HOST is unset the scanner is "unavailable":
# files are accepted into private quarantine (status "pending") and nobody can open them until a scan succeeds.
# A real clamd and a provider decision are LAUNCH BLOCKERS (see README).
CLAMD_HOST=
CLAMD_PORT=3310

# Shared secret for POST /api/v1/jobs/rescan (Authorization: Bearer <secret>). Leave unset to disable the endpoint.
# Use a long random value (for example `openssl rand -hex 32`) in production.
CRON_SECRET=

# Phase 7 government-assistance monitor: shared secret for POST /api/v1/jobs/gov (Authorization: Bearer <secret>).
# Leave unset to disable the endpoint. The database switches (monitoring/publishing/notifications) are all OFF until an
# administrator enables them. GOV_WORKER_CONTACT (optional) is added to the User-Agent so agencies can reach the operator.
GOV_WORKER_SECRET=
GOV_WORKER_CONTACT=
