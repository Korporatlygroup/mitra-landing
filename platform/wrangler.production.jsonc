// Worker `inok-app-production` (Workers Paid; limits.cpu_ms is only accepted on the Paid plan). Domain app.inok.my is attached with the access gate still required.
// Deploy with: npx wrangler deploy -c wrangler.production.jsonc   (after `npm run cf:build:production` with the production
// project's URL, publishable key and INOK_PRODUCTION_REF in the shell). Separate Worker, separate secrets, no staging credentials.
// Access gate lifted on the owner's instruction (2026-11-17): ACCESS_GATE is "off". Set it back to "required" and redeploy to close the site again.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inok-app-production",
  "main": "cf-entry.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": { "SITE_URL": "https://app.inok.my", "ACCESS_GATE": "off" },
  "routes": [{ "pattern": "app.inok.my", "custom_domain": true }],
  "limits": { "cpu_ms": 30000 },
  "triggers": { "crons": ["*/2 * * * *"] },
  "workers_dev": true,
  "preview_urls": false
}
