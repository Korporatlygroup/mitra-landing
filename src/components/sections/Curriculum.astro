---
import site from '../../../content/site.json';
import Media from '../Media.astro';

const { curriculum } = site;

// 24x24 stroke icons, keyed by site.json `icon`.
const icons: Record<string, string> = {
  compass: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5z"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>',
  video: '<rect x="3" y="6" width="13" height="12" rx="2"/><path d="m16 10 5-3v10l-5-3z"/>',
  image: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/>',
  share: '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  sparkles: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>',
  cart: '<circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M3 4h2l2.4 11h11.2L21 8H6.2"/>',
};
---

<section class="section section--alt" id="curriculum">
  <div class="container">
    <div class="section__head">
      <h2 data-reveal>{curriculum.heading}</h2>
      <p class="lead" data-reveal style="--d:80">{curriculum.intro}</p>
    </div>
    <div class="groups">
      {curriculum.groups.map((g, gi) => (
        <div class="group" data-reveal style={`--d:${gi * 120}`}>
          <h3>{g.title}</h3>
          {'intro' in g && g.intro && <p class="group__intro">{g.intro}</p>}
          <ul>
            {g.modules.map((m, mi) => (
              <li class="module" style={`--d:${gi * 120 + mi * 70 + 150}`}>
                <span class="module__icon">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[m.icon] ?? icons.compass} />
                </span>
                <span class="module__body">
                  <span class="module__title">{m.title}</span>
                  {'text' in m && m.text && <span class="module__text">{m.text}</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="shots">
      {curriculum.images.map((id, i) => (
        <div class="shot" data-reveal="scale" style={`--d:${i * 110}`}>
          <Media id={id} sizes="(min-width: 900px) 33vw, 100vw" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .groups { display: grid; gap: 1rem; }
  .group { padding: 1.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .group h3 { margin: 0 0 0.5rem; font-size: 1.35rem; }
  .group__intro { margin: 0 0 1rem; line-height: 1.55; color: var(--text-muted); }
  .group ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .module {
    display: flex; align-items: flex-start; gap: 0.9rem; padding: 0.6rem 0.65rem; margin-inline: -0.65rem;
    border-radius: var(--radius-sm); font-size: 1.02rem; line-height: 1.3;
    transition: background-color 0.25s ease, transform 0.3s var(--ease-out);
  }
  .module__body { display: grid; gap: 0.3rem; padding-top: 0.2rem; }
  .module__title { font-weight: 650; }
  .module__text { font-size: 0.95rem; line-height: 1.5; color: var(--text-muted); }
  .module__icon {
    flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px;
    background: var(--brand-soft); color: var(--accent-text);
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.45s var(--ease-spring);
  }
  .module:hover { background: var(--surface-2); }
  .module:hover .module__icon { background: var(--brand); color: var(--brand-ink); transform: rotate(-8deg) scale(1.08); }
  .shots { display: grid; gap: 1rem; margin-top: clamp(1.5rem, 4vw, 2.5rem); }
  .shot { overflow: hidden; border-radius: var(--radius-lg); }
  .shot :global(.media) { aspect-ratio: 3 / 2; height: auto; border-radius: 0; transition: transform 0.9s var(--ease-out); }
  .shot:hover :global(.media) { transform: scale(1.05); }
  @media (min-width: 700px) { .shots { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .groups { grid-template-columns: repeat(3, 1fr); } }
</style>
