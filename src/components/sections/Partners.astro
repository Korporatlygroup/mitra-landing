---
// Credentials strip. Rendered inside the Contact band, so the trust signals sit where the decision happens.
// Each partner shows its official logo when the file exists (media.json → media/logos/…); otherwise a role icon + name.
import site from '../../../content/site.json';
import Media from '../Media.astro';
import { getMedia } from '../../lib/media';

const { partners } = site;
const d = partners.deliverer;
const c = partners.certifier;
const items = partners.items.filter((p) => p.permitted);
const hasLogo = (p: { permitted: boolean; logo: string }) => p.permitted && getMedia(p.logo).available;

// 24x24 line icons. pathLength=1 lets every stroke "draw" in with the same timing.
const icons: Record<string, string> = {
  store: '<path pathLength="1" d="M3 9h18l-1.5-5h-15z"/><path pathLength="1" d="M4.5 9v11h15V9"/><path pathLength="1" d="M10 20v-6h4v6"/>',
  certificate: '<rect pathLength="1" x="3" y="4" width="18" height="12" rx="2"/><path pathLength="1" d="M7 8h10M7 11h6"/><circle pathLength="1" cx="16.5" cy="17.5" r="2.5"/><path pathLength="1" d="m15 19.5-1 3 2.5-1 2.5 1-1-3"/>',
  shield: '<path pathLength="1" d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6z"/><path pathLength="1" d="m8.5 12 2.5 2.5 4.5-5"/>',
  badge: '<circle pathLength="1" cx="12" cy="9" r="6"/><path pathLength="1" d="m9.5 14.5-1.5 7 4-2 4 2-1.5-7"/><path pathLength="1" d="m9.5 9 1.8 1.8L14.8 7.5"/>',
  award: '<path pathLength="1" d="m12 3 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>',
  hand: '<path pathLength="1" d="M3 13h3l3 2h4a1.5 1.5 0 0 1 0 3H9"/><path pathLength="1" d="M13 18h3.5l4-3.5a1.4 1.4 0 0 0-2-2L16 14"/><path pathLength="1" d="M3 20h4"/><circle pathLength="1" cx="15" cy="6" r="3"/>',
};
---

<div class="creds" id="partners">
  <h2 class="visually-hidden">{partners.heading}</h2>

  <div class="creds__deliverer" data-reveal>
    <p class="creds__label">{partners.delivererLabel}</p>
    <div class="deliverer">
      <span class="mark mark--lg">
        {hasLogo(d) ? (
          <Media id={d.logo} fit="contain" sizes="72px" class="mark__logo" />
        ) : (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[d.icon]} />
        )}
      </span>
      <div>
        <p class="deliverer__name">{d.name}</p>
        <p class="deliverer__full">{d.fullName}</p>
        {d.description && <p class="deliverer__desc">{d.description}</p>}
        <ul class="facts">
          {d.facts.map((f) => <li>{f}</li>)}
        </ul>
        {d.address && <p class="deliverer__addr">{d.address}</p>}
      </div>
    </div>
  </div>

  {c?.permitted && (
    <div class="creds__certifier" data-reveal style="--d:120">
      <p class="creds__label">{partners.certifierLabel}</p>
      <div class="certifier">
        {getMedia(c.logo).available ? (
          <div class="certifier__logo"><Media id={c.logo} fit="contain" sizes="(min-width: 900px) 320px, 80vw" /></div>
        ) : (
          <span class="mark mark--lg">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[c.icon]} />
          </span>
        )}
        <div>
          <p class="deliverer__name">{c.name}</p>
          <p class="certifier__role">{c.role}</p>
          {c.group && <p class="deliverer__full">{c.group}</p>}
        </div>
      </div>
    </div>
  )}

  <div class="creds__list-wrap">
    <p class="creds__label" data-reveal>{partners.credentialsLabel}</p>
    <ul class="creds__list" style={`--n:${items.length}`}>
      {items.map((p, i) => (
        <li class="cred" data-reveal style={`--d:${100 + i * 90}`}>
          <span class:list={['mark', { 'mark--logo': hasLogo(p) }]}>
            {hasLogo(p) ? (
              <Media id={p.logo} fit="contain" sizes="96px" class="mark__logo" />
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[p.icon]} />
            )}
          </span>
          <div class="cred__text">
            <p class="cred__name">{p.name}</p>
            <p class="cred__role">{p.role}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .creds {
    display: grid; gap: 2rem; margin-top: clamp(3rem, 6vw, 4.5rem); padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1.5px solid rgb(42 21 0 / 0.18); color: var(--brand-ink);
  }
  
  .creds__label { margin: 0 0 1rem; font-weight: 650; font-size: 0.95rem; color: rgb(42 21 0 / 0.72); }

  /* Logo tiles / icon marks: one shape for every partner so the row lines up. */
  .mark {
    flex: none; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px;
    background: #fff7e8; color: #8c1d40; box-shadow: 0 6px 16px -10px rgb(42 21 0 / 0.6);
    transition: transform 0.45s var(--ease-spring), box-shadow 0.3s ease;
  }
  .mark svg { width: 26px; height: 26px; }
  .mark--lg { width: 72px; height: 72px; border-radius: 18px; }
  .mark--lg svg { width: 34px; height: 34px; }
  .mark--logo { width: 96px; padding: 6px 10px; background: #fff; }
  .mark :global(.mark__logo) { width: 100%; height: 100%; object-fit: contain; border-radius: 0; background: transparent; filter: grayscale(1); opacity: 0.85; transition: filter 0.35s ease, opacity 0.35s ease; }

  /* Icons draw themselves in once the strip scrolls into view (and are simply shown without JS or with reduced motion). */
  .mark svg :global(*) { stroke-dasharray: 1; stroke-dashoffset: 0; }
  :global(.js) [data-reveal]:global(.is-pre) .mark svg :global(*) { stroke-dashoffset: 1; }
  :global(.js) [data-reveal]:global(.is-pre.is-in) .mark svg :global(*) { stroke-dashoffset: 0; transition: stroke-dashoffset 1.1s var(--ease-out) calc(var(--d, 0) * 1ms + 250ms); }

  .deliverer { display: flex; gap: 1.1rem; align-items: flex-start; }
  .deliverer p { margin: 0; }
  .deliverer__name { font: 700 1.6rem/1.1 var(--font-display); font-stretch: 94%; letter-spacing: -0.015em; }
  .deliverer__full { margin-top: 0.2rem !important; color: rgb(42 21 0 / 0.75); }
  .deliverer__addr { margin-top: 0.6rem !important; font-size: 0.9rem; color: rgb(42 21 0 / 0.72); }
  .deliverer__desc { margin-top: 0.6rem !important; max-width: 52ch; line-height: 1.5; color: rgb(42 21 0 / 0.85); }

  /* Certification partner: full-colour lockup on its own white card, never greyscaled. */
  .certifier { display: grid; gap: 1rem; align-items: center; padding: 1.25rem; border-radius: var(--radius-lg); background: #fff; box-shadow: 0 14px 30px -20px rgb(42 21 0 / 0.7); }
  .certifier p { margin: 0; }
  .certifier__logo { width: min(340px, 100%); }
  .certifier__logo :global(.media) { background: transparent; border-radius: 0; }
  .certifier__role { margin-top: 0.25rem !important; font-weight: 650; color: #8c1d40; }
  @media (min-width: 1000px) { .creds { grid-template-columns: 1fr 1fr; align-items: start; } .creds__list-wrap { grid-column: 1 / -1; } }
  .facts { list-style: none; margin: 0.8rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .facts li { padding: 0.3rem 0.7rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; background: rgb(255 247 232 / 0.65); }

  .creds__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: 1fr; }
  @media (min-width: 600px) { .creds__list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .creds__list { grid-template-columns: repeat(var(--n, 5), 1fr); } .cred { flex-direction: column; } }
  .cred {
    display: flex; gap: 0.9rem; align-items: flex-start; padding: 0.9rem; border-radius: 16px;
    background: rgb(255 247 232 / 0.45); border: 1px solid rgb(42 21 0 / 0.08);
    transition: background-color 0.3s ease, transform 0.35s var(--ease-out), box-shadow 0.3s ease;
  }
  .cred__text { min-width: 0; }
  .cred p { margin: 0; }
  .cred__name { font: 700 1.1rem/1.2 var(--font-display); }
  .cred__role { font-size: 0.9rem; font-weight: 600; color: #8c1d40; }
  .cred:hover { background: rgb(255 247 232 / 0.85); transform: translateY(-3px); box-shadow: 0 14px 28px -18px rgb(42 21 0 / 0.55); }
  .cred:hover .mark { transform: rotate(-6deg) scale(1.06); }
  .cred:hover .mark :global(.mark__logo) { filter: none; opacity: 1; }
</style>
