---
import site from '../../../content/site.json';
import Media from '../Media.astro';
import FilmPlayer from '../FilmPlayer.astro';
import { videoParts } from '../../lib/content';

const { journey } = site;
const steps = journey.steps
  .filter((s) => !('verify' in s && s.verify))
  // A step's film (its parts that exist) takes the place of its photo.
  .map((s) => ({ ...s, parts: videoParts(('film' in s && s.film) || []) }));
const phaseLabel = (p?: string) => journey.phases[(p ?? 'inclass') as 'inclass' | 'online'];
const first = steps[0];
---

<section class="section" id="journey">
  <div class="container journey">
    {/* Sticky side panel: follows the reader and shows which step they are on. */}
    <div class="journey__aside">
      <h2 data-reveal>{journey.heading}</h2>
      {journey.intro && <p class="journey__intro" data-reveal style="--d:80">{journey.intro}</p>}
      <div class="now" data-reveal style="--d:120" aria-hidden="true">
        <span class="now__phase" data-journey-phase>{phaseLabel(first?.phase)}</span>
        <span class="now__date" data-journey-date>{first?.date}</span>
        <div class="now__bar"><span data-journey-bar></span></div>
      </div>
    </div>

    <div class="timeline" data-journey>
      <span class="timeline__track" aria-hidden="true"><span class="timeline__fill" data-journey-fill></span></span>
      <ol class="timeline__list">
      {steps.map((s, i) => (
        <li
          class:list={['step', `step--${s.phase}`, { 'step--media': s.parts.length > 0 || !!s.image }]}
          data-step
          data-phase={phaseLabel(s.phase)}
          data-date={s.date}
          data-reveal
          style={`--d:${i * 60}`}
        >
          <span class="step__dot" aria-hidden="true"></span>
          <div class="step__card">
            <p class="step__meta">
              <time>{s.date}</time>
              {'module' in s && s.module && <span class="step__module">{s.module}</span>}
            </p>
            <h3>{s.title}</h3>
            <p class="step__text">{s.text}</p>
            {'takeaway' in s && s.takeaway && (
              <p class="step__takeaway"><strong>{journey.takeawayLabel}</strong> {s.takeaway}</p>
            )}
            {s.parts.length > 0 ? (
              <div class="step__media step__media--film">
                <FilmPlayer parts={s.parts} label={`${s.date} film`} />
                {journey.filmCaption && <p class="step__caption">{journey.filmCaption.replace('{day}', s.date)}</p>}
              </div>
            ) : s.image && (
              <div class="step__media">
                <Media id={s.image} sizes="(min-width: 900px) 560px, 100vw" />
              </div>
            )}
          </div>
        </li>
      ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .journey { display: grid; gap: 2.5rem; }
  .journey__intro { margin: 1rem 0 0; max-width: 42ch; font-size: 1.08rem; line-height: 1.6; color: var(--text-muted); }
  .now { display: grid; gap: 0.35rem; margin-top: 1.5rem; padding: 1.25rem 1.4rem; border-radius: var(--radius-lg); background: var(--surface-2); max-width: 360px; }
  .now__phase { font-weight: 650; color: var(--accent-text); }
  .now__date { font: 700 clamp(1.6rem, 3vw, 2.2rem)/1.1 var(--font-display); font-stretch: 90%; letter-spacing: -0.02em; transition: opacity 0.25s ease; }
  .now__date.is-swapping { opacity: 0; }
  .now__bar { height: 6px; margin-top: 0.75rem; border-radius: 6px; background: var(--border); overflow: hidden; }
  .now__bar span { display: block; height: 100%; width: calc(var(--p, 0) * 100%); background: linear-gradient(90deg, var(--brand), var(--accent)); border-radius: inherit; transition: width 0.15s linear; }

  .timeline { position: relative; padding-left: 2.25rem; }
  .timeline__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .timeline__track { position: absolute; left: 7px; top: 8px; bottom: 8px; width: 3px; border-radius: 3px; background: var(--border-strong); }
  .timeline__fill { position: absolute; inset: 0 0 auto; height: calc(var(--p, 0) * 100%); border-radius: inherit; background: linear-gradient(180deg, var(--brand), var(--accent)); }
  :global(html:not(.js)) .timeline__fill { height: 100%; }

  .step { position: relative; }
  .step__dot {
    position: absolute; left: calc(-2.25rem + 1px); top: 1.55rem; width: 15px; height: 15px; border-radius: 50%;
    background: var(--bg); border: 3px solid var(--border-strong);
    transition: border-color 0.3s ease, background-color 0.3s ease, transform 0.4s var(--ease-spring);
  }
  .step:global(.is-reached) .step__dot, :global(html:not(.js)) .step__dot { border-color: var(--brand); background: var(--brand); transform: scale(1.15); }
  .step__card {
    padding: 1.4rem 1.5rem; border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--border);
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s var(--ease-out);
  }
  .step:global(.is-active) .step__card { border-color: var(--brand); box-shadow: var(--shadow-lift); }
  .step--online .step__card { background: var(--surface-2); }
  .step__meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35rem 0.75rem; margin: 0; }
  .step time { font-size: 0.9rem; font-weight: 700; color: var(--accent-text); }
  .step__module { font-size: 0.82rem; font-weight: 650; letter-spacing: 0.02em; color: var(--text-muted); }
  .step h3 { margin: 0.25rem 0 0.5rem; font-size: 1.4rem; }
  .step__text { color: var(--text-muted); margin: 0; line-height: 1.6; }
  .step__takeaway {
    margin: 0.9rem 0 0; padding: 0.7rem 0.9rem; border-radius: var(--radius-sm);
    background: var(--brand-soft); line-height: 1.5;
  }
  .step__takeaway strong { color: var(--accent-text); }
  .step__media { margin-top: 1.1rem; overflow: hidden; border-radius: var(--radius); }
  .step__media--film { overflow: visible; }
  .step__media :global(.media) { aspect-ratio: 16 / 9; height: auto; border-radius: 0; }
  .step__caption { margin: 0.5rem 0 0; font-size: 0.85rem; color: var(--text-muted); }

  @media (min-width: 900px) {
    .journey { grid-template-columns: minmax(260px, 1fr) 1.6fr; gap: 4rem; align-items: start; }
    .journey__aside { position: sticky; top: calc(var(--nav-h) + 2rem); }
  }
  @media (max-width: 899px) { .now { display: none; } }
</style>
