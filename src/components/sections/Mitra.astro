---
// The MITRA-funded programme, told as GET Academy's delivery: what MITRA's funding made possible and what we built with it.
// Deliberately no MITRA track-record figures: this section showcases our work, not MITRA's (user decision 2026-11-07).
import site from '../../../content/site.json';
import Media from '../Media.astro';
import { getMedia } from '../../lib/media';

const { mitra } = site;
// Claims flagged "verify" stay hidden until confirmed against the records.
const delivered = mitra.delivered.filter((d) => !('verify' in d && d.verify));
const hasImage = getMedia(mitra.image).available;

const icons: Record<string, string> = {
  store: '<path d="M3 9h18l-1.5-5h-15z"/><path d="M4.5 9v11h15V9"/><path d="M10 20v-6h4v6"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="m9 15 2 2 4-4"/>',
  users: '<circle cx="9" cy="8" r="3"/><path d="M3 20v-1a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14a4 4 0 0 1 4 4v2"/>',
  hand: '<path d="M3 13h3l3 2h4a1.5 1.5 0 0 1 0 3H9"/><path d="M13 18h3.5l4-3.5a1.4 1.4 0 0 0-2-2L16 14"/><path d="M3 20h4"/><circle cx="15" cy="6" r="3"/>',
  certificate: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M7 8h10M7 11h6"/><circle cx="16.5" cy="17.5" r="2.5"/>',
  award: '<path d="m12 3 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>',
};
---

<section class="section mitra" id="mitra">
  <div class="container mitra__grid">
    <div class="mitra__story">
      <p class="mitra__eyebrow" data-reveal>{mitra.eyebrow}</p>
      <h2 data-reveal style="--d:80">{mitra.heading}</h2>
      <p class="lead" data-reveal style="--d:140">{mitra.intro}</p>
      {hasImage && (
        <figure class="mitra__photo" data-reveal="scale" style="--d:200">
          <Media id={mitra.image} sizes="(min-width: 1000px) 420px, 90vw" />
          {mitra.imageCaption && <figcaption>{mitra.imageCaption}</figcaption>}
        </figure>
      )}
    </div>

    <div class="mitra__delivered">
      <h3 class="mitra__sub" data-reveal>{mitra.deliveredHeading}</h3>
      <ol class="deliv">
        {delivered.map((d, i) => (
          <li data-reveal style={`--d:${80 + i * 70}`}>
            <span class="deliv__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[d.icon] ?? icons.award} />
            </span>
            <div>
              <p class="deliv__title">{d.title}</p>
              <p class="deliv__text">{d.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div class="container">
    <div class="mitra__statement" data-reveal>
      <p>{mitra.statement}</p>
      <a class="btn btn--primary" href={mitra.cta.href}>{mitra.cta.label}</a>
    </div>
  </div>
</section>

<style>
  .mitra__grid { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (min-width: 1000px) { .mitra__grid { grid-template-columns: 5fr 6fr; } .mitra__story { position: sticky; top: calc(var(--nav-h) + 1.5rem); } }
  .mitra__eyebrow { margin: 0 0 0.5rem; font-weight: 650; color: var(--accent-text); }
  .mitra__story h2 { margin-bottom: 0.4em; }

  .mitra__photo { margin: clamp(1.5rem, 3vw, 2rem) 0 0; max-width: 420px; }
  .mitra__photo :global(.media) { aspect-ratio: 4 / 5; border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .mitra__photo figcaption { margin-top: 0.6rem; font-size: 0.9rem; color: var(--text-muted); }

  .mitra__sub { margin-bottom: 1.1rem; }
  .deliv { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.8rem; counter-reset: deliv; }
  .deliv li {
    counter-increment: deliv; position: relative; display: flex; gap: 1rem; align-items: flex-start;
    padding: 1.2rem 1.2rem 1.2rem 1.1rem; border-radius: 18px; background: var(--surface);
    border: 1px solid var(--border); box-shadow: var(--shadow); border-left: 5px solid var(--brand);
    transition: transform 0.35s var(--ease-out), box-shadow 0.3s ease;
  }
  .deliv li:nth-child(even) { border-left-color: var(--accent); }
  .deliv li:hover { transform: translateX(4px); box-shadow: var(--shadow-lift); }
  .deliv li::after {
    content: counter(deliv, decimal-leading-zero); position: absolute; top: 0.9rem; right: 1.1rem;
    font: 700 0.85rem/1 var(--font-display); color: var(--border-strong);
  }
  .deliv p { margin: 0; }
  .deliv__icon { flex: none; display: grid; place-items: center; width: 46px; height: 46px; border-radius: 12px; background: var(--surface-2); color: var(--accent); }
  .deliv__icon svg { width: 24px; height: 24px; }
  .deliv__title { font: 650 1.1rem/1.25 var(--font-display); margin: 0 2rem 0.3rem 0 !important; }
  .deliv__text { font-size: 0.97rem; line-height: 1.5; color: var(--text-muted); }

  .mitra__statement {
    margin-top: clamp(2.5rem, 5vw, 3.5rem); padding: clamp(1.6rem, 4vw, 2.6rem);
    display: flex; flex-wrap: wrap; gap: 1.25rem 2rem; align-items: center; justify-content: space-between;
    border-radius: var(--radius-lg); background: var(--accent-deep); color: var(--on-accent);
  }
  .mitra__statement p { margin: 0; max-width: 26ch; font: 700 clamp(1.5rem, 3.2vw, 2.3rem)/1.15 var(--font-display); font-stretch: 92%; letter-spacing: -0.015em; }
</style>
