---
import site from '../../../content/site.json';
import Awning from '../Awning.astro';
import Partners from './Partners.astro';

const { contact } = site;
const whatsapp = contact.whatsapp ? `https://wa.me/${String(contact.whatsapp).replace(/\D/g, '')}` : null;
const email = contact.email ? `mailto:${contact.email}` : null;
const hasDirect = !!(whatsapp || email);
// Each audience path opens an email with its own subject line, so enquiries arrive pre-sorted.
const mailto = (subject: string) => `${email}?subject=${encodeURIComponent(subject)}`;
const paths = email ? contact.paths : [];
// Only post enquiries over HTTPS (and add that host to form-action in astro.config.mjs).
const rawAction: string = contact.formAction ?? '';
const formAction = rawAction.startsWith('https://') ? rawAction : null;

const icons: Record<string, string> = {
  sprout: '<path d="M12 21v-9"/><path d="M12 12c0-4 3-7 8-7 0 5-3 7-8 7z"/><path d="M12 14c0-3-2.5-5.5-7-5.5 0 4 2.5 5.5 7 5.5z"/>',
  mic: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/>',
  people: '<circle cx="9" cy="8" r="3"/><path d="M3 20v-1a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14a4 4 0 0 1 4 4v2"/>',
};
---

<section class="contact" id="contact">
  <Awning />
  <div class="container contact__inner">
    <div>
      <h2 data-reveal>{contact.heading}</h2>
      <p class="contact__body" data-reveal style="--d:80">{contact.body}</p>
      {contact.email && (
        <p class="contact__direct" data-reveal style="--d:120">
          Or write to us at <a href={email!}>{contact.email}</a>
        </p>
      )}
    </div>

    {formAction ? (
      <form class="form" method="post" action={formAction} data-reveal style="--d:160">
        <label>Name<input name="name" autocomplete="name" maxlength="100" required /></label>
        <label>Organisation<input name="organisation" autocomplete="organization" maxlength="150" /></label>
        <label>Email<input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
        <label>Message<textarea name="message" rows="4" maxlength="2000"></textarea></label>
        {/* Honeypot: hidden from people, filled by bots; the form service should drop submissions that set it. */}
        <input class="visually-hidden" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn btn--dark" type="submit">{contact.labels.submit}</button>
      </form>
    ) : paths.length > 0 ? (
      <ul class="paths">
        {paths.map((p, i) => (
          <li class="path" data-reveal style={`--d:${160 + i * 90}`}>
            <span class="path__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[p.icon] ?? icons.sprout} />
            </span>
            <div class="path__text">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
              <a class="btn btn--dark" href={mailto(p.subject)}>{p.cta}</a>
            </div>
          </li>
        ))}
        {whatsapp && (
          <li class="path path--wa" data-reveal style="--d:340">
            <a class="btn btn--outline" href={whatsapp} target="_blank" rel="noopener noreferrer">{contact.labels.whatsapp}</a>
          </li>
        )}
      </ul>
    ) : (
      <div class="contact__actions" data-reveal style="--d:160">
        {whatsapp && (
          <a class="btn btn--dark" href={whatsapp} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.3.4c-.1.1-.3.3-.1.6.2.3.7 1.2 1.6 2 1.1 1 2 1.3 2.3 1.4.3.1.4.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>
            {contact.labels.whatsapp}
          </a>
        )}
        {email && (
          <a class="btn btn--outline" href={email}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            {contact.labels.email}
          </a>
        )}
        <a class:list={['btn', hasDirect ? 'btn--link' : 'btn--dark']} href={contact.fallback.href}>{contact.fallback.label}</a>
      </div>
    )}
  </div>
  <div class="container">
    <Partners />
  </div>
</section>

<style>
  .contact { position: relative; background: var(--brand); color: var(--brand-ink); padding-bottom: var(--section-y); }
  /* Maroon-led awning on marigold, so the stripes still read against the band. */
  .contact :global(.awning) { background: repeating-linear-gradient(90deg, var(--accent) 0 44px, var(--accent-deep) 44px 88px); }
  .contact__inner { display: grid; gap: 2rem; align-items: center; padding-top: calc(var(--section-y) - 1.5rem); }
  .contact h2 { max-width: 16ch; }
  .contact__body { font-size: clamp(1.1rem, 1.6vw, 1.25rem); line-height: 1.55; max-width: 48ch; color: color-mix(in srgb, var(--brand-ink) 82%, transparent); margin: 0; }
  .contact__direct { margin: 1rem 0 0; font-weight: 600; }
  .contact__direct a { color: var(--brand-ink); text-underline-offset: 4px; overflow-wrap: anywhere; }
  .contact__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; }
  .contact :global(.btn--dark) { background: var(--brand-ink); color: #fff3df; box-shadow: 0 12px 26px -14px rgb(42 21 0 / 0.9); }
  .btn--outline { border-color: var(--brand-ink); color: var(--brand-ink); }
  .btn--outline:hover { background: rgb(42 21 0 / 0.08); }
  .btn--link { color: var(--brand-ink); text-decoration: underline; text-underline-offset: 4px; padding-inline: 0.5rem; }

  /* Two audience paths: learners and organisations, each a card with its own email subject. */
  .paths { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .path { display: flex; gap: 1rem; align-items: flex-start; padding: 1.35rem; border-radius: var(--radius-lg); background: #fffaf0; box-shadow: 0 14px 30px -20px rgb(42 21 0 / 0.7); }
  .path h3 { margin: 0 0 0.3rem; font: 700 1.25rem/1.2 var(--font-display); }
  .path p { margin: 0 0 1rem; line-height: 1.5; color: rgb(42 21 0 / 0.78); }
  .path__icon { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--brand); color: var(--accent-deep); }
  .path__icon svg { width: 26px; height: 26px; }
  .path--wa { background: transparent; box-shadow: none; padding: 0; }

  .form { display: grid; gap: 0.9rem; padding: 1.5rem; border-radius: var(--radius-lg); background: rgb(255 255 255 / 0.35); }
  .form label { display: grid; gap: 0.35rem; font-weight: 650; font-size: 0.92rem; }
  .form input, .form textarea { font: inherit; padding: 0.8rem 0.95rem; border-radius: var(--radius-sm); border: 1.5px solid rgb(42 21 0 / 0.2); background: #fffaf0; color: #2a1500; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
  .form input:focus, .form textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgb(140 29 64 / 0.2); }

  @media (min-width: 900px) { .contact__inner { grid-template-columns: 1.1fr 1fr; gap: 3rem; } .contact__actions { justify-content: flex-end; } }
</style>
