---
import site from '../../../content/site.json';
import Awning from '../Awning.astro';
import Partners from './Partners.astro';

const { contact } = site;
const whatsapp = contact.whatsapp ? `https://wa.me/${String(contact.whatsapp).replace(/\D/g, '')}` : null;
const email = contact.email ? `mailto:${contact.email}` : null;
const hasDirect = !!(whatsapp || email);

// Enquire box: same contact values, plus a pre-filled message. Buttons only render when their value is set.
const enquire = contact.enquire;
const enquireWhatsapp = whatsapp ? `${whatsapp}?text=${encodeURIComponent(enquire.whatsappMessage)}` : null;
const enquireEmail = email ? `${email}?subject=${encodeURIComponent(enquire.emailSubject)}` : null;
const enquireDirect = !!(enquireWhatsapp || enquireEmail);
---

<section class="contact" id="contact">
  <Awning />
  <div class="container contact__inner">
    <div>
      <h2 data-reveal>{contact.heading}</h2>
      <p class="contact__body" data-reveal style="--d:80">{contact.body}</p>
    </div>

    {contact.formAction ? (
      <form class="form" method="post" action={contact.formAction} data-reveal style="--d:160">
        <label>Name<input name="name" autocomplete="name" required /></label>
        <label>Organisation<input name="organisation" autocomplete="organization" /></label>
        <label>Email<input name="email" type="email" autocomplete="email" required /></label>
        <label>Message<textarea name="message" rows="4"></textarea></label>
        <button class="btn btn--dark" type="submit">{contact.labels.submit}</button>
      </form>
    ) : (
      <div class="contact__actions" data-reveal style="--d:160">
        {whatsapp && (
          <a class="btn btn--dark" href={whatsapp} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.3.4c-.1.1-.3.3-.1.6.2.3.7 1.2 1.6 2 1.1 1 2 1.3 2.3 1.4.3.1.4.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>
            {contact.labels.whatsapp}
          </a>
        )}
        {email && (
          <a class="btn btn--outline" href={email}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            {contact.labels.email}
          </a>
        )}
        <a class:list={['btn', hasDirect ? 'btn--link' : 'btn--dark']} href={contact.fallback.href}>{contact.fallback.label}</a>
      </div>
    )}
  </div>
  <div class="container">
    <Partners />
  </div>
  <div class="container">
    <div class="enquire" id="enquire" data-reveal>
      <div class="enquire__text">
        <h3>{enquire.heading}</h3>
        <p class="enquire__line">{enquire.line}</p>
        {(enquire.nextIntake || enquire.price) && (
          <ul class="enquire__facts">
            {enquire.nextIntake && <li><strong>{enquire.labels.nextIntake}</strong> {enquire.nextIntake}</li>}
            {enquire.price && <li><strong>{enquire.labels.price}</strong> {enquire.price}</li>}
          </ul>
        )}
      </div>
      <div class="enquire__actions">
        {enquireWhatsapp && (
          <a class="btn btn--dark" href={enquireWhatsapp} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.3.4c-.1.1-.3.3-.1.6.2.3.7 1.2 1.6 2 1.1 1 2 1.3 2.3 1.4.3.1.4.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>
            {contact.labels.whatsapp}
          </a>
        )}
        {enquireEmail && (
          <a class="btn btn--outline" href={enquireEmail}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            {contact.labels.email}
          </a>
        )}
        {!enquireDirect && <a class="btn btn--dark" href={contact.fallback.href}>{contact.fallback.label}</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .contact { position: relative; background: var(--brand); color: var(--brand-ink); padding-bottom: var(--section-y); }
  /* Maroon-led awning on marigold, so the stripes still read against the band. */
  .contact :global(.awning) { background: repeating-linear-gradient(90deg, var(--accent) 0 44px, var(--accent-deep) 44px 88px); }
  .contact__inner { display: grid; gap: 2rem; align-items: center; padding-top: calc(var(--section-y) - 1.5rem); }
  .contact h2 { max-width: 16ch; }
  .contact__body { font-size: clamp(1.1rem, 1.6vw, 1.25rem); line-height: 1.55; max-width: 48ch; color: color-mix(in srgb, var(--brand-ink) 82%, transparent); margin: 0; }
  .contact__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; }
  .contact :global(.btn--dark) { background: var(--brand-ink); color: #fff3df; box-shadow: 0 12px 26px -14px rgb(42 21 0 / 0.9); }
  .btn--outline { border-color: var(--brand-ink); color: var(--brand-ink); }
  .btn--outline:hover { background: rgb(42 21 0 / 0.08); }
  .btn--link { color: var(--brand-ink); text-decoration: underline; text-underline-offset: 4px; padding-inline: 0.5rem; }

  .form { display: grid; gap: 0.9rem; padding: 1.5rem; border-radius: var(--radius-lg); background: rgb(255 255 255 / 0.35); }
  .form label { display: grid; gap: 0.35rem; font-weight: 650; font-size: 0.92rem; }
  .form input, .form textarea { font: inherit; padding: 0.8rem 0.95rem; border-radius: var(--radius-sm); border: 1.5px solid rgb(42 21 0 / 0.2); background: #fffaf0; color: #2a1500; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
  .form input:focus, .form textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgb(140 29 64 / 0.2); }

  .enquire {
    display: grid; gap: 1.25rem; align-items: center; margin-top: clamp(2.5rem, 5vw, 3.5rem); padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-lg); background: rgb(255 255 255 / 0.35); border: 1.5px solid rgb(42 21 0 / 0.12);
  }
  .enquire h3 { margin: 0; font: 700 clamp(1.4rem, 2.4vw, 1.8rem)/1.15 var(--font-display); font-stretch: 94%; letter-spacing: -0.015em; }
  .enquire__line { margin: 0.35rem 0 0; font-size: 1.1rem; color: color-mix(in srgb, var(--brand-ink) 82%, transparent); }
  .enquire__facts { list-style: none; margin: 0.9rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .enquire__facts li { padding: 0.3rem 0.75rem; border-radius: 999px; font-size: 0.9rem; background: rgb(255 247 232 / 0.7); }
  .enquire__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; }
  @media (min-width: 900px) { .enquire { grid-template-columns: 1.3fr 1fr; gap: 3rem; } .enquire__actions { justify-content: flex-end; } }

  @media (min-width: 900px) { .contact__inner { grid-template-columns: 1.3fr 1fr; gap: 3rem; } .contact__actions { justify-content: flex-end; } }
</style>
