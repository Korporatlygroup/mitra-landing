---
import site from '../../../content/site.json';
import Logo from '../Logo.astro';

const { footer, organiser } = site;
---

<footer class="footer">
  <div class="container footer__inner">
    <div>
      <Logo height={40} />
      <span class="footer__muted">{footer.tagline}</span>
    </div>
    <div>
      <strong>{organiser.name}</strong>
      <span class="footer__muted">{organiser.fullName}</span>
      <address>{footer.address}</address>
    </div>
    <a href={footer.website}>{footer.website.replace(/^https?:\/\//, '')}</a>
    {footer.socials.map((s: { label: string; href: string }) => <a href={s.href}>{s.label}</a>)}
    <small class="footer__muted">{footer.legal}</small>
  </div>
</footer>

<style>
  .footer { padding-block: 2.5rem; border-top: 1px solid var(--border); font-size: 0.92rem; }
  .footer__inner { display: grid; gap: 1.25rem; }
  .footer__inner > div { display: grid; gap: 0.4rem; align-content: start; }
  .footer address { font-style: normal; }
  .footer__muted { color: var(--text-muted); }
  @media (min-width: 900px) { .footer__inner { grid-template-columns: 1.2fr 1.2fr auto; align-items: start; } .footer small { grid-column: 1 / -1; } }
</style>
