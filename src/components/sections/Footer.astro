---
import site from '../../../content/site.json';
import Logo from '../Logo.astro';

const { footer, organiser } = site;
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Logo height={44} />
      <span class="footer__muted">{footer.tagline}</span>
    </div>
    <div>
      <strong>{organiser.name}</strong>
      <span class="footer__muted">{organiser.fullName}</span>
      <address>{footer.address}</address>
    </div>
    <div class="footer__links">
      <a href={footer.website}>{footer.website.replace(/^https?:\/\//, '')}</a>
      {footer.socials.map((s: { label: string; href: string }) => <a href={s.href}>{s.label}</a>)}
      <a href="#top">{footer.backToTop}</a>
    </div>
    <small class="footer__muted">{footer.legal}</small>
  </div>
</footer>

<style>
  .footer { padding-block: 3.5rem 2.5rem; background: var(--footer-bg); color: var(--footer-text); font-size: 0.95rem; }
  .footer__inner { display: grid; gap: 2rem; }
  .footer__inner > div { display: grid; gap: 0.45rem; align-content: start; }
  .footer :global(.logo) { color: #fff3df; margin-bottom: 0.5rem; }
  .footer address { font-style: normal; }
  .footer__muted { color: color-mix(in srgb, var(--footer-text) 65%, transparent); }
  .footer a { text-decoration: none; width: fit-content; background: linear-gradient(var(--brand), var(--brand)) 0 100% / 0 2px no-repeat; transition: background-size 0.3s var(--ease-out); }
  .footer a:hover { background-size: 100% 2px; }
  .footer small { padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / 0.1); }
  @media (min-width: 900px) { .footer__inner { grid-template-columns: 1.3fr 1.2fr auto; } .footer small { grid-column: 1 / -1; } }
</style>
