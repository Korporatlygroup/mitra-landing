---
// Participants' own screenshots from the final report's evidence annex (site.json → evidence._note).
import site from '../../../content/site.json';
import Media from '../Media.astro';
import { getMedia } from '../../lib/media';

const { evidence } = site;
const ready = (id: string) => getMedia(id).available;
const items = evidence.items
  .map((it) => ({ ...it, media: it.media.filter(ready) }))
  .filter((it) => it.media.length > 0);
const quizReady = ready(evidence.quiz.media);
---

{items.length > 0 && (
  <section class="section section--alt evidence" id="evidence">
    <div class="container">
      <div class="section__head">
        <p class="evidence__eyebrow" data-reveal>{evidence.eyebrow}</p>
        <h2 data-reveal style="--d:80">{evidence.heading}</h2>
        <p class="lead" data-reveal style="--d:140">{evidence.intro}</p>
      </div>

      {evidence.measure && (
        <div class="measure">
          <h3 class="measure__heading" data-reveal>{evidence.measure.heading}</h3>
          <div class="measure__grid">
            <article class="measure__card" data-reveal style="--d:80">
              <p class="measure__label">{evidence.measure.knowledge.label}</p>
              <h4>{evidence.measure.knowledge.title}</h4>
              <p>{evidence.measure.knowledge.text}</p>
              <ul class="quiz__areas">
                {evidence.measure.knowledge.areas.map((a) => <li>{a}</li>)}
              </ul>
              {quizReady && <a class="measure__link" href={evidence.measure.knowledge.link.href}>{evidence.measure.knowledge.link.label}</a>}
            </article>
            <article class="measure__card" data-reveal style="--d:160">
              <p class="measure__label">{evidence.measure.business.label}</p>
              <h4>{evidence.measure.business.title}</h4>
              <p>{evidence.measure.business.text}</p>
              <dl class="aspects">
                {evidence.measure.business.aspects.map((a) => (
                  <div class="aspect">
                    <dt>{a.aspect}</dt>
                    <dd><strong>{a.value}</strong> {a.text}</dd>
                  </div>
                ))}
              </dl>
            </article>
          </div>
        </div>
      )}

      <ul class="proofs">
        {items.map((it, i) => (
          <li class="proof" data-reveal style={`--d:${80 + i * 80}`}>
            <div class:list={['proof__shots', { 'proof__shots--two': it.media.length > 1 && it.layout !== 'stack' }]}>
              {it.media.map((m) => (
                <div class="shot">
                  <Media id={m} fit="contain" sizes="(min-width: 1000px) 520px, 92vw" />
                </div>
              ))}
            </div>
            <div class="proof__text">
              <p class="proof__channel">{it.channel}</p>
              <h3>{it.business}</h3>
              <p class="proof__name">{it.name}</p>
              <ul class="proof__points">
                {it.points.map((p) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>

      <div class="quiz" id="quiz" data-reveal>
        <div class="quiz__text">
          <h3>{evidence.quiz.title}</h3>
          <p>{evidence.quiz.text}</p>
        </div>
        {quizReady && (
          <div class="quiz__shot">
            <Media id={evidence.quiz.media} fit="contain" sizes="(min-width: 900px) 460px, 92vw" />
          </div>
        )}
      </div>

      <p class="evidence__source">{evidence.sourceNote}</p>
    </div>
  </section>
)}

<style>
  .evidence__eyebrow { margin: 0 0 0.5rem; font-weight: 650; color: var(--accent-text); }

  /* How we measured: knowledge (self-assessment) beside business aspects tracked. */
  .measure { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .measure__heading { margin: 0 0 1rem; font: 700 clamp(1.3rem, 2.4vw, 1.6rem)/1.2 var(--font-display); }
  .measure__grid { display: grid; gap: clamp(1.25rem, 3vw, 1.75rem); }
  @media (min-width: 1000px) { .measure__grid { grid-template-columns: 1fr 1.25fr; } }
  .measure__card {
    padding: clamp(1.2rem, 3vw, 1.7rem); border-radius: var(--radius-lg);
    background: var(--surface); border: 1px solid var(--border); border-top: 5px solid var(--brand); box-shadow: var(--shadow);
  }
  .measure__card:nth-child(2) { border-top-color: var(--accent); }
  .measure__label { margin: 0 0 0.3rem; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--accent-text); }
  .measure__card h4 { margin: 0 0 0.5rem; font: 700 clamp(1.2rem, 2.1vw, 1.4rem)/1.2 var(--font-display); }
  .measure__card > p:not(.measure__label) { margin: 0 0 1rem; line-height: 1.6; color: var(--text-muted); }
  .measure__link { display: inline-block; margin-top: 1rem; font-weight: 650; color: var(--accent-text); text-underline-offset: 4px; }
  .aspects { margin: 0; display: grid; gap: 0.6rem; }
  .aspect { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.75rem; align-items: baseline; padding: 0.6rem 0; border-top: 1px solid var(--border); }
  .aspect:first-child { border-top: 0; padding-top: 0; }
  .aspect dt { font-weight: 700; font-size: 0.92rem; }
  .aspect dd { margin: 0; line-height: 1.45; color: var(--text-muted); }
  .aspect strong { font: 700 1.2rem/1 var(--font-display); color: var(--text); margin-right: 0.15rem; }
  @media (max-width: 420px) { .aspect { grid-template-columns: 1fr; gap: 0.2rem; } }

  .proofs { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(1.25rem, 3vw, 1.75rem); }
  @media (min-width: 1000px) { .proofs { grid-template-columns: repeat(2, 1fr); } }
  .proof {
    display: grid; gap: 1.25rem; align-content: start; padding: clamp(1rem, 2.5vw, 1.4rem);
    border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow);
  }
  .proof__shots { display: grid; gap: 0.75rem; align-items: start; }
  @media (min-width: 560px) { .proof__shots--two { grid-template-columns: 1.2fr 1fr; } }
  /* Screenshots keep their own proportions; capped so tall phone captures don't dominate. */
  .shot { display: grid; place-items: center; padding: 0.6rem; border-radius: var(--radius); background: var(--surface-2); border: 1px solid var(--border); }
  .shot :global(.media) { width: auto; max-width: 100%; height: auto; max-height: 420px; aspect-ratio: auto; border-radius: 10px; object-fit: contain; box-shadow: 0 10px 24px -18px rgb(42 21 0 / 0.6); }

  .proof__channel { margin: 0 0 0.25rem; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--accent-text); }
  .proof h3 { margin: 0; font: 700 clamp(1.25rem, 2.2vw, 1.5rem)/1.2 var(--font-display); }
  .proof__name { margin: 0.15rem 0 0.8rem; color: var(--text-muted); font-weight: 600; }
  .proof__points { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .proof__points li { display: flex; gap: 0.55rem; align-items: flex-start; line-height: 1.45; }
  .proof__points svg { flex: none; width: 20px; height: 20px; margin-top: 0.1rem; padding: 2px; border-radius: 50%; background: var(--brand); color: var(--brand-ink); }

  .quiz {
    display: grid; gap: 1.5rem; align-items: start; margin-top: clamp(2rem, 4vw, 2.75rem);
    padding: clamp(1.2rem, 3vw, 1.8rem); border-radius: var(--radius-lg);
    background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow);
  }
  @media (min-width: 900px) { .quiz { grid-template-columns: 1fr 460px; gap: 2.5rem; } }
  .quiz h3 { margin: 0 0 0.6rem; font: 700 clamp(1.3rem, 2.4vw, 1.6rem)/1.2 var(--font-display); }
  .quiz__text > p { margin: 0 0 1rem; line-height: 1.6; color: var(--text-muted); max-width: 56ch; }
  .quiz__areas { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .quiz__areas li { padding: 0.4rem 0.8rem; border-radius: 999px; background: var(--brand-soft); font-size: 0.9rem; font-weight: 600; }
  /* The quiz page is tall: show its top, which carries the before/after columns. */
  .quiz__shot { max-height: 520px; overflow: hidden; border-radius: var(--radius); border: 1px solid var(--border); background: #fff; }
  .quiz__shot :global(.media) { display: block; width: 100%; height: auto; aspect-ratio: auto; border-radius: 0; }

  .evidence__source { margin: 1.5rem 0 0; font-size: 0.9rem; color: var(--text-muted); }
</style>
