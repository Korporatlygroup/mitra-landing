---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Mitra from '../components/sections/Mitra.astro';
import Kpis from '../components/sections/Kpis.astro';
import Results from '../components/sections/Results.astro';
import Impact from '../components/sections/Impact.astro';
import Curriculum from '../components/sections/Curriculum.astro';
import Journey from '../components/sections/Journey.astro';
import Trainer from '../components/sections/Trainer.astro';
import Interviews from '../components/sections/Interviews.astro';
import Gallery from '../components/sections/Gallery.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/sections/Footer.astro';
---

<Base>
